{
  "$schema": "../dist/config/config.schema.json",
  "version": 2,
  "instance": {
    "name": "dev-write",
    "transport": "stdio",
    "environment": "development",
    "tier": "read_write",
    "journal": {
      "directory": "/run/db-mcp/dev-journal",
      "maxOperations": 1000,
      "retentionDays": 7,
      "previewTtlMs": 60000,
      "maxPrepared": 20
    }
  },
  "sources": [
    {
      "id": "dev-mysql",
      "engine": "mysql",
      "required": true,
      "purpose": "Isolated development database only",
      "host": "127.0.0.1",
      "port": 3306,
      "database": "dev_app",
      "username": "mcp_writer",
      "passwordRef": "file:/run/secrets/db-mcp-dev-writer",
      "tls": {
        "mode": "disabled"
      },
      "access": {
        "tier": "read_write",
        "tables": [
          "items"
        ],
        "columns": {
          "items": [
            "id",
            "version",
            "name"
          ]
        },
        "rawSql": false,
        "allowedTools": [
          "mysql_select",
          "mysql_describe_table",
          "mysql_prepare_write"
        ],
        "writes": {
          "metadataGuard": "mcp_write_metadata",
          "tables": {
            "items": {
              "keyColumns": [
                "id"
              ],
              "versionColumn": "version",
              "writableColumns": [
                "name"
              ],
              "allowInsert": true,
              "allowUpdate": true,
              "allowDelete": false
            }
          }
        }
      }
    }
  ]
}
